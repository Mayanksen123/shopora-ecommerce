@app.route("/product/<int:product_id>", methods=["GET", "POST"])
def product_detail(product_id):
    db = get_db()
    product = db.execute("SELECT * FROM products WHERE id=?", (product_id,)).fetchone()
    if not product:
        flash("Product not found.", "error")
        return redirect(url_for("home"))

    if request.method == "POST":
        if not current_user() or session.get("role") != "buyer":
            flash("Please log in as a buyer first.", "error")
            return redirect(url_for("login"))
        qty = max(1, int(request.form.get("quantity", 1)))
        action = request.form.get("action")
        if action == "cart":
            _add_to_cart(product_id, qty)
            flash("Added to cart!", "success")
            return redirect(url_for("product_detail", product_id=product_id))
        elif action == "buy":
            session["buy_now"] = {"product_id": product_id, "quantity": qty}
            return redirect(url_for("payment", product_id=product_id))

    reviews = db.execute("""
        SELECT r.*, u.name reviewer_name FROM reviews r
        JOIN users u ON u.id = r.user_id
        WHERE r.product_id=? ORDER BY r.created_at DESC
    """, (product_id,)).fetchall()
    avg_rating = (sum(r["rating"] for r in reviews) / len(reviews)) if reviews else 0
    seller = db.execute("SELECT name FROM users WHERE id=?", (product["seller_id"],)).fetchone()

    return render(PRODUCT_BODY, product=product, reviews=reviews, avg_rating=avg_rating,
                  seller_name=seller["name"] if seller else "Unknown Seller",
                  default_image=DEFAULT_IMAGE, title=product["name"])


