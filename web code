@app.route("/payment/<int:product_id>", methods=["GET", "POST"])
@login_required
@role_required("buyer")
def payment(product_id):
    db = get_db()
    buy_now = session.get("buy_now")

    if buy_now:  # single "Buy Now" item
        product = db.execute("SELECT * FROM products WHERE id=?", (buy_now["product_id"],)).fetchone()
        items = [{"name": product["name"], "price": product["price"],
                  "quantity": buy_now["quantity"], "product_id": product["id"],
                  "seller_id": product["seller_id"]}]
    else:  # full cart checkout
        rows = db.execute("""
            SELECT c.quantity, p.id product_id, p.name, p.price, p.seller_id FROM cart c
            JOIN products p ON p.id = c.product_id WHERE c.user_id=?
        """, (session["user_id"],)).fetchall()
        items = [dict(r) for r in rows]

    if not items:
        flash("Nothing to checkout.", "error")
        return redirect(url_for("home"))

    total = sum(it["price"] * it["quantity"] for it in items)
    buyer = current_user()
    default_address = f"{buyer['address']}, {buyer['city']}, {buyer['state']} - {buyer['pincode']}" if buyer["address"] else ""

    if request.method == "POST":
        ship_address = request.form["ship_address"]
        payment_method = request.form["payment_method"]
        for it in items:
            db.execute("""INSERT INTO orders
                (user_id,product_id,seller_id,quantity,total_price,ship_address,payment_method,status,created_at)
                VALUES (?,?,?,?,?,?,?,?,?)""",
                (session["user_id"], it["product_id"], it["seller_id"], it["quantity"],
                 it["price"] * it["quantity"], ship_address, payment_method, "Confirmed",
                 datetime.datetime.now().isoformat()))
        if not buy_now:
            db.execute("DELETE FROM cart WHERE user_id=?", (session["user_id"],))
        session["buy_now"] = None
        db.commit()
        flash("🎉 Order placed successfully! Thank you for shopping with Shopora.", "success")
        return redirect(url_for("home"))

    return render(PAYMENT_BODY, items=items, total=total, default_address=default_address, title="Payment")


