@app.route("/admin/dashboard")
@login_required
@role_required("admin")
def admin_dashboard():
    db = get_db()
    buyers = db.execute("SELECT * FROM users WHERE role='buyer' ORDER BY created_at DESC").fetchall()
    sellers = db.execute("SELECT * FROM users WHERE role='seller' ORDER BY created_at DESC").fetchall()
    orders = db.execute("""
        SELECT o.*, u.name buyer_name, p.name product_name, s.name seller_name
        FROM orders o
        JOIN users u ON u.id = o.user_id
        JOIN products p ON p.id = o.product_id
        JOIN users s ON s.id = o.seller_id
        ORDER BY o.created_at DESC
    """).fetchall()
    gmv = sum(o["total_price"] for o in orders)
    return render(ADMIN_DASH_BODY, buyers=buyers, sellers=sellers, orders=orders, gmv=gmv,
                  title="Owner Dashboard")


