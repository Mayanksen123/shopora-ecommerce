        <select name="category" required>
          {% for c in categories %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
        </select>
      </div>
      <div class="form-row"><label>Product Image (upload)</label><input name="image_file" type="file" accept="image/*"></div>
      <div class="form-row"><label>...or Image URL (optional)</label><input name="image_url" placeholder="https://..."></div>
      <button class="btn btn-gold" style="width:100%;" type="submit">Publish Product</button>
    </form>
  </div>
</div>
"""


@app.route("/seller/add-product", methods=["GET", "POST"])
@login_required
@role_required("seller")
def add_product():
    if request.method == "POST":
        f = request.form
        image_url = f.get("image_url", "").strip()

        file = request.files.get("image_file")
        if file and file.filename and allowed_file(file.filename):
            filename = secure_filename(f"{session['user_id']}_{int(datetime.datetime.now().timestamp())}_{file.filename}")
            file.save(os.path.join(app.config["UPLOAD_FOLDER"], filename))
            image_url = url_for("uploaded_file", filename=filename)

        db = get_db()
        db.execute("""INSERT INTO products (seller_id,name,description,price,category,image_url,stock,created_at)
                      VALUES (?,?,?,?,?,?,?,?)""",
                   (session["user_id"], f["name"], f["description"], float(f["price"]),
                    f["category"], image_url, int(f["stock"]), datetime.datetime.now().isoformat()))
        db.commit()
        flash("Product published successfully!", "success")
        return redirect(url_for("seller_dashboard"))
    return render(ADD_PRODUCT_BODY, title="Add Product")


@app.route("/uploads/<filename>")
def uploaded_file(filename):
    return send_from_directory(app.config["UPLOAD_FOLDER"], filename)


